{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniforge.dev/schemas/project-contract/v1.0.0.schema.json",
  "title": "OmniForge Project Contract v1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "roadmap_file",
    "project_state_file",
    "source_branch",
    "integration_branch",
    "validation_profile"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "minLength": 1},
    "roadmap_file": {"type": "string", "minLength": 1},
    "project_state_file": {"type": "string", "minLength": 1},
    "source_branch": {"type": "string", "minLength": 1},
    "integration_branch": {"type": "string", "minLength": 1},
    "validation_profile": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "policy": {"type": "object", "additionalProperties": true}
  }
}
