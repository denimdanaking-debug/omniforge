{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniforge.dev/schemas/domain/provider-identity-v1.0.0.schema.json",
  "title": "OmniForge Provider Identity v1.0.0",
  "type": "object",
  "required": ["provider_id", "display_name", "failure_domain"],
  "additionalProperties": true,
  "properties": {
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "display_name": {"type": "string", "minLength": 1},
    "failure_domain": {"type": "string", "minLength": 1},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
