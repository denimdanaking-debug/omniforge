{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniforge.dev/schemas/domain/inference-route-v1.0.0.schema.json",
  "title": "OmniForge Inference Route Identity v1.0.0",
  "type": "object",
  "required": ["route_id", "provider_id", "route_type", "endpoint_key", "failure_domain"],
  "additionalProperties": true,
  "properties": {
    "route_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]{1,127}$"},
    "provider_id": {"type": "string", "minLength": 1},
    "route_type": {"enum": ["direct", "gateway", "local", "enterprise"]},
    "endpoint_key": {"type": "string", "minLength": 1},
    "failure_domain": {"type": "string", "minLength": 1},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
